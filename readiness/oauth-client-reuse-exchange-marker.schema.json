{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "state",
    "approved",
    "prepared_commit_sha",
    "plan_sha256",
    "manifest_sha256",
    "workflow_sha256",
    "executor_sha256",
    "schema_sha256"
  ],
  "properties": {
    "identity": {
      "const": "provider-neutral-youtube-client-reuse-exchange-20261015-r1"
    },
    "state": {
      "const": "CONSUMED_BEFORE_REMOTE"
    },
    "approved": {
      "const": true
    },
    "prepared_commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "workflow_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "executor_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
