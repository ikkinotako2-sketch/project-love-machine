{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "state",
    "approved",
    "prepared_commit_sha",
    "plan_sha256",
    "manifest_sha256",
    "workflow_sha256",
    "executor_sha256",
    "schema_sha256",
    "execution_approval"
  ],
  "properties": {
    "identity": {
      "const": "provider-neutral-youtube-client-reuse-exchange-20261024-r2"
    },
    "state": {
      "const": "CONSUMED_BEFORE_REMOTE"
    },
    "approved": {
      "const": true
    },
    "prepared_commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "workflow_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "executor_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "execution_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_approved",
        "operational_exclusion_attested",
        "writer_permissions_reviewed",
        "handoff_approved"
      ],
      "properties": {
        "owner_approved": {
          "const": true
        },
        "operational_exclusion_attested": {
          "const": true
        },
        "writer_permissions_reviewed": {
          "const": true
        },
        "handoff_approved": {
          "const": true
        }
      }
    }
  }
}
