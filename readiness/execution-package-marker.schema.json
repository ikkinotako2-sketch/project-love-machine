{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "operation",
    "state",
    "prepared_commit_sha",
    "approved",
    "plan_sha256",
    "source_manifest_sha256",
    "workflow_sha256",
    "executor_sha256",
    "schema_sha256"
  ],
  "properties": {
    "identity": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "channel",
        "state_init",
        "private_upload",
        "finalize",
        "migration",
        "migration_postcheck",
        "worker_deploy",
        "worker_postcheck"
      ]
    },
    "state": {
      "const": "CONSUMED_BEFORE_REMOTE"
    },
    "prepared_commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "approved": {
      "const": true
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "workflow_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "executor_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
